# Spotify app credentials — copy this file to `.env` and fill in.
# Create an app at https://developer.spotify.com/dashboard
#
# PKCE flow is used, so NO client secret is needed (and none should be put in
# a frontend bundle). Only the Client ID and a registered Redirect URI.

VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Set to "mock" to use deterministic fake audio features (no Spotify audio
# endpoints needed — useful because Spotify deprecated audio-features/analysis
# for new apps). Set to "spotify" to use the real endpoints. Default: mock.
VITE_FEATURE_PROVIDER=mock
